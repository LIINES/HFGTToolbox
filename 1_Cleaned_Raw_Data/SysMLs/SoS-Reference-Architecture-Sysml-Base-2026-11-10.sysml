		part transformationResource : TransformationResource;
		part transportProcess : TransportProcess;
		part transportationResource : TransportationResource;
		part validator : Validator;
		item operand : Operand;
	}	
	part def TransformationResource {
		attribute autonomous :> autonomous = "true";
		attribute decisionMaker :> decisionMaker = "";
		attribute finalCond;
		attribute gpsX;
		attribute gpsY;
		attribute idx;
		attribute idxBuffer;
		attribute idxResource;
		attribute initCond;
		attribute linearCostCoeff;
		attribute lowerBound;
		attribute name;
		attribute number;
		attribute quadCostCoeff;
		attribute requiredKeys;
		attribute status :> status = "true";
		attribute transformationResourceName;
		attribute upperBound;
		attribute validator;
		attribute varDomain;
		attribute varDomainEnabled;
		action transformProcess;
		action transportProcess;
	}
