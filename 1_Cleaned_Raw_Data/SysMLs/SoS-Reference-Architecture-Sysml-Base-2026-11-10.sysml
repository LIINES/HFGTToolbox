		attribute varDomainEnabled :> varDomainEnabled = "real+";
		action transformProcess;
		action transportProcess;
		doc /* Section 2:  Reference architecture attributes, parts, actions, and items */
		action 'charge ev-driver' : 'Charge EV-Driver';
	}
