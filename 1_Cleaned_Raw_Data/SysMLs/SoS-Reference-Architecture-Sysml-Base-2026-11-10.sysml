	}
	part def OperandPlace{
		attribute finalCond;
		attribute initCond;
		attribute linearCostCoeff;
		attribute name;
		attribute placeType :> placeType = "internal";
		attribute upperBound;
		attribute varDomain :> varDomain = "real+";
	}
	part def OperandTransition{
		attribute name;
		attribute postset;
		attribute postsetWeight;
		attribute preset;
		attribute presetWeight;
		attribute processLinkName;
		attribute processLinkRef;
		attribute processLinkWeight;
