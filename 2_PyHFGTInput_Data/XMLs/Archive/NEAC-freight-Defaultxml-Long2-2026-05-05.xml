                       presetWeight="1,1,1"
                       postset="allowed-to-drive"
                       postsetWeight="1"
                       processLinkName="transport ev-driver"
                       processLinkRef="hold ev-driver"
                       varDomain="binary"/>
    <OperandTransition name="begin rest period"
                       preset="allowed-to-drive,driver-energy-level"
                       presetWeight="1,1"
                       postset="allowed-to-rest,driver-breaktime-level"
                       postsetWeight="1,11"
                       processLinkName=""
                       processLinkRef=""
                       varDomain="binary"/>
