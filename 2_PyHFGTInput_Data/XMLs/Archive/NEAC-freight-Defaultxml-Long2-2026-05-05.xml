    <OperandTransition name="charge state-of-charge"
                       preset="allowed-to-rest,driver-breaktime-level"
                       presetWeight="1,1"
                       postset="state-of-charge,allowed-to-rest"
                       postsetWeight="1,1"
                       processLinkName="charge ev-driver"
                       processLinkRef=""
                       varDomain="binary"/>
    <OperandTransition name="park"
                       preset="allowed-to-rest,driver-breaktime-level"
                       presetWeight="1,1"
                       postset="allowed-to-rest"
                       postsetWeight="1"
                       processLinkName=""
                       processLinkRef=""
                       varDomain="binary"/>
