<?xml version="1.0" encoding="utf-8"?>
<!-- Demand and Supply: attributes for transitions: demand="true" or "false", supply="true" or "false" - when true, there is an accompanying CSV file that contains the time series data. When false: ignored.
Tesla model Y has 82 kWh battery capacity.
Tesla discharge rate is 5kwh per 24 h ~ 1 (round up).

ProcessLinkRef can be left empty if the processLinkName links to a TransformationProcess rather than to a TransportationProcess.
The maximum no. of hours a driver can rest is 8 h (+1).
The maximum no. of hours a driver can drive is 16 h (+1).
TransformationResource: Initial condition is 500 km (distance to travel), final condition is 0 km.
Where to define the weight of arc EN Q1 -> U1?
-->
<LFES name="NEAC-freight"
      scenario="base"
      refArchitecture="NEAC Freight"
      dataState="raw"
      inputDataFormat="defaultXML"
      verboseMode="true"
      analysisMethod="HFNMCF"
      outputFileType="json"
      optimizer="Gurobi"
      simHorizon="40"
      deltaT="1"
      hasESN_STF1="true"
      hasESN_STF2="false"
      hasESN_Duration="false"
      hasESNEnablingConstraint="false"
      hasBufferLinearCost="true"
      hasBufferQuadCost="false"
      hasBufferUpperBound="false"
      hasBufferLowerBound = "false"
      hasBufferInitCond="true"
      hasBufferFinalCond="true"
      hasProcessLinearCostFlowNeg="false"
      hasProcessLinearCostFlowPos="false"
      hasProcessLinearCostStock="false"
      hasProcessQuadCostFlowNeg="false"
      hasProcessQuadCostFlowPos="false"
      hasProcessQuadCostStock="false"
      hasProcessUpperBoundFlowNeg="false"
      hasProcessUpperBoundFlowPos="false"
      hasProcessUpperBoundStock="false"
      hasProcessLowerBoundFlowNeg="false"
      hasProcessLowerBoundFlowPos="false"
      hasProcessLowerBoundStock="false"
      hasProcessInitCond="false"
      hasProcessFinalCond="false"
      hasProcessDuration="false"
      hasProcessValues="false"
      hasProcessUpperBoundRamp="false"
      hasProcessLowerBoundRamp="false">
  <Operand operandName="ev-driver"
           operandType="matter"
           operandNetName="ev-driver"
           status="true"
           hasOperandNet_Duration="false"
           hasOperandNet_STF1="true"
           hasOperandNet_STF2="false"
           hasOperandNetEnablingConstraint="true"
           hasSyncMatNeg="true"
           hasSyncMatPos="false"
           hasPlaceCost="false"
           hasPlaceLinearCost = "false"
           hasPlaceQuadCost = "false"
           hasPlaceUpperBound="false"
           hasPlaceLowerBound = "false"
           hasPlaceInitConds="true"
           hasPlaceFinalConds="false"
           hasTransitionLinearCostFlowNeg="false"
           hasTransitionLinearCostFlowPos="false"
           hasTransitionLinearCostStock="false"
           hasTransitionQuadCostFlowNeg="false"
           hasTransitionQuadCostFlowPos="false"
           hasTransitionQuadCostStock="false"
           hasTransitionUpperBoundFlowNeg="false"
           hasTransitionUpperBoundFlowPos="false"
           hasTransitionUpperBoundStock="false"
           hasTransitionLowerBoundFlowNeg="false"
           hasTransitionLowerBoundFlowPos="false"
           hasTransitionLowerBoundStock="false"
           hasTransitionDurationConds="false"
           hasTransitionFinalConds="false"
           hasTransitionInitConds="false">
    <OperandPlace name="state of charge"
                  placeType="internal"
                  initCond="10"
                  finalCond="10"
                  varDomain="real+"/>
    <OperandPlace name="allowed-to-drive"
              placeType="internal"
              initCond="1"
              finalCond="0"
              varDomain="binary"/>
    <OperandPlace name="driver energy level"
                  placeType="internal"
                  initCond="11"
                  finalCond="0"
                  varDomain="real+"/>
    <OperandPlace name="allowed-to-rest"
              placeType="internal"
              initCond="0"
              finalCond="1"
              varDomain="binary"/>
    <OperandPlace name="driver-breaktime-level"
                  placeType="internal"
                  initCond="0"
                  finalCond="1"
                  varDomain="real+"/>
    <OperandTransition name="charge state of charge"
                       preset="allowed-to-rest,driver-breaktime-level"
                       presetWeight="1,1"
                       postset="state of charge,allowed-to-rest"
                       postsetWeight="1,1"
                       processLinkName=""
                       processLinkRef=""
                       varDomain="binary"/>
    <OperandTransition name="park"
                       preset="allowed-to-rest,driver-breaktime-level"
                       presetWeight="1,1"
                       postset="allowed-to-rest"
                       postsetWeight="1"
                       processLinkName=""
                       processLinkRef=""
                       varDomain="binary"/>
    <OperandTransition name="discharge state of charge"
                       preset="state of charge,allowed-to-drive,driver energy level"
                       presetWeight="1,1,1"
                       postset="allowed-to-drive"
                       postsetWeight="1"
                       processLinkName="reduce trip distance"
                       processLinkRef=""
                       varDomain="binary"/>
    <OperandTransition name="begin rest period"
                       preset="allowed-to-drive,driver energy level"
                       presetWeight="1,1"
                       postset="allowed-to-rest,driver-breaktime-level"
                       postsetWeight="1,11"
                       processLinkName=""
                       processLinkRef=""
                       varDomain="binary"/>
    <OperandTransition name="begin driving shift"
                   preset="allowed-to-rest,driver-breaktime-level"
                   presetWeight="1,1"
                   postset="allowed-to-drive,driver energy level"
                   postsetWeight="1,11"
                   processLinkName=""
                   processLinkRef=""
                   varDomain="binary"/>
  </Operand>
  <TransformationResource transformationResourceName="electrified transportation system"
                          gpsX="1"
                          gpsY="1"
                          decisionMaker=""
                          autonomous="true"
                          initCond="500"
                          finalCond="0"
                          linearCostCoeff = "1"
                          upperBound="500"
                          varDomain="real+">
    <TransformationProcess name="reduce trip distance"
                           inputOperand="ev-driver"
                           inputOperandWeight="25"
                           outputOperand=""
                           outputOperandWeight=""
                           upperBoundFlowNeg="3000"
                           status="true"
                           varDomain="binary"/>
  </TransformationResource>
</LFES>
